{
	"name": "@whosydd/pi-fleet",
	"version": "0.1.0",
	"description": "Fleet orchestration for pi: plan with the bundled skills, then dispatch one ticket at a time to a Codex or Claude executor in a Herdr pane and judge the result contract.",
	"type": "module",
	"license": "MIT",
	"author": "whosydd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/whosydd/pi-fleet.git"
	},
	"homepage": "https://github.com/whosydd/pi-fleet#readme",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"fleet",
		"orchestration",
		"codex",
		"claude",
		"herdr"
	],
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		],
		"skills": [
			"./skills/fleet"
		]
	},
	"scripts": {
		"install-planning": "node scripts/install-planning.mjs",
		"check-planning": "node scripts/install-planning.mjs --check",
		"test": "node --test test/*.test.ts",
		"typecheck": "tsc --noEmit",
		"smoke": "node smoke/load.ts",
		"check": "npm run typecheck && npm run test && npm run smoke && npm run check-planning"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.0.0",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.1.0",
		"@types/node": "^26.4.1",
		"typebox": "^1.3.27",
		"typescript": "^7.0.2"
	}
}
